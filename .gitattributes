# Fins de ligne normalisées pour le code et la doc
* text=auto eol=lf
*.bat text eol=crlf
# --- Git LFS : fichiers binaires (Unreal, art, audio) ---
# Unreal
*.uasset filter=lfs diff=lfs merge=lfs -text lockable
*.umap   filter=lfs diff=lfs merge=lfs -text lockable
# Sources d'art
*.blend  filter=lfs diff=lfs merge=lfs -text lockable
*.fbx    filter=lfs diff=lfs merge=lfs -text
*.glb    filter=lfs diff=lfs merge=lfs -text
*.psd    filter=lfs diff=lfs merge=lfs -text lockable
# Images
*.png    filter=lfs diff=lfs merge=lfs -text
*.jpg    filter=lfs diff=lfs merge=lfs -text
*.jpeg   filter=lfs diff=lfs merge=lfs -text
*.webp   filter=lfs diff=lfs merge=lfs -text
*.tga    filter=lfs diff=lfs merge=lfs -text
*.exr    filter=lfs diff=lfs merge=lfs -text
# Audio / vidéo
*.wav    filter=lfs diff=lfs merge=lfs -text
*.ogg    filter=lfs diff=lfs merge=lfs -text
*.mp3    filter=lfs diff=lfs merge=lfs -text
*.mp4    filter=lfs diff=lfs merge=lfs -text
# Données générées du monde (relief)
tools/worldgen/output/*.bin filter=lfs diff=lfs merge=lfs -text

# Images web du site (versions légères tirées de art/) : hors LFS, pour que Vercel les lise.
site/src/assets/** -filter -diff -merge
site/public/** -filter -diff -merge
