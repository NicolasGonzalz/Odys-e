---
// Une créature : sa silhouette, son nom, une phrase.
import { Image } from "astro:assets";
import type { Creature } from "../data/creatures";
interface Props {
  creature: Creature;
}
const { creature } = Astro.props;
---
<article class="creature reveal">
  <div class="cadre">
    <Image src={creature.image} alt={creature.nom} widths={[320, 480]} sizes="(max-width: 720px) 90vw, 320px" />
  </div>
  <h3>{creature.nom}</h3>
  <p>{creature.texte}</p>
</article>
<style>
  .creature {
    border: 1px solid var(--bord);
    border-radius: var(--rayon);
    background: var(--surface);
    overflow: hidden;
    transition: transform 0.2s ease, border-color 0.2s ease;
  }
  .creature:hover {
    transform: translateY(-4px);
    border-color: var(--mousse-sombre);
  }
  .cadre {
    aspect-ratio: 1;
    overflow: hidden;
    background: #6b7f8e;
  }
  .cadre img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.5s ease;
  }
  .creature:hover img {
    transform: scale(1.06);
  }
  h3 {
    margin: 1rem 1.2rem 0.3rem;
    font-size: 1.2rem;
  }
  p {
    margin: 0 1.2rem 1.2rem;
    color: var(--texte-doux);
    font-size: 0.95rem;
  }
</style>
